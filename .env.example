# Public PostHog project token only. Never use a personal/secret API key here.
# Copy to .env.local for an uncommitted local configuration, or configure the
# same variables in the main-site build environment. Empty token disables capture.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional visualizer API override (must end in /api).
# For local Herd development, put the following in .env.development.local:
# VITE_FOOD_API_BASE_URL=https://pinoy-food-api.test/api
# The default production API is https://api.juanutrisyon.info/api.
VITE_FOOD_API_BASE_URL=
